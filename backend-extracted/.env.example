PORT=4000
# app_user is a NON-superuser role (created in schema.sql) so row-level security actually applies
DATABASE_URL=postgres://app_user:app_pass@localhost:5432/provchain
REDIS_URL=redis://localhost:6379
QR_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-admin-key
PUBLIC_VERIFY_URL=http://localhost:3000/verify
MAX_TRAVEL_KMH=900
SCAN_THRESHOLD=5
